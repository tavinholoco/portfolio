# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# capturas de tela de desenvolvimento (pnpm look)
/.captures/

# ajustes locais do Claude Code (contém caminhos da máquina)
/.claude/settings.local.json

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel (o projeto antigo, que só redireciona para o domínio desde a fase E da §17)
.vercel

# wrangler (estado local do wrangler dev)
/.wrangler/

# freebuff (dados locais do app, nunca versionar)
.freebuff

# typescript
*.tsbuildinfo
next-env.d.ts
