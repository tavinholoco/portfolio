{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "mkdir -p vercel-redirect",
  "outputDirectory": "vercel-redirect",
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://pedrolevi.com.br/:path*",
      "permanent": true
    }
  ]
}
