# URL canônica do site (canonical, hreflang, sitemap e Open Graph).
# No deploy da Vercel, defina isso com seu domínio real (ex.: https://pedrolevi.dev).
# Sem essa variável, o site usa automaticamente a URL do deploy (VERCEL_URL).
NEXT_PUBLIC_SITE_URL=https://pedrolevi.dev

# Google Analytics 4: ID de medição (ex.: G-XXXXXXXXXX).
# Sem essa variável, o script do GA não é carregado no site.
NEXT_PUBLIC_GA_ID=
